@@ -326,8 +326,8 @@ class StructuredOutputManager:
-        # Parsers that know their end tokens also report whether one is content.
-        if reasoner.reasoning_end_token_ids:
-            end = reasoner.find_reasoning_end(spec_tokens)
-            if end is not None:
-                constraint_start = end.offset + 1
-                if end.implicit:
-                    return ConstraintBounds(end.offset, constraint_start)
-                return ConstraintBounds(constraint_start, constraint_start)
+        # Parsers may locate multi-token ends too. None requires the
+        # context-aware fallback (e.g. a marker split across decode steps).
+        end = reasoner.find_reasoning_end(spec_tokens)
+        if end is not None:
+            constraint_start = end.offset + 1
+            if end.implicit:
+                return ConstraintBounds(end.offset, constraint_start)
+            return ConstraintBounds(constraint_start, constraint_start)
diff --git a/vllm/v1/token_buffer.py b/vllm/v1/token_buffer.py
index c258c03bc7..7ea7a3dbe9 100644
--- a/vllm/v1/token_buffer.py
+++ b/vllm/v1/token_buffer.py
@@ -188,0 +189,12 @@ class TokenIdsView(Sequence[int]):
+        if self._list is None and isinstance(index, slice):
+            start, stop, step = index.indices(self._len)
+            split = len(self._tokens)
+            if step == 1:
+                result = list(self._tokens[start : min(stop, split)])
+                if stop > split:
+                    result.extend(self._suffix[max(0, start - split) : stop - split])
+                return result
+            return [
+                self._tokens[i] if i < split else self._suffix[i - split]
+                for i in range(start, stop, step)
+            ]
